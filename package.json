{
  "name": "tutormayor-stitch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "css": "tailwindcss -i src/tailwind.css -o public/style.css --minify",
    "dev": "npm run build && npm run preview",
    "build": "npm run generate && npm run css && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.0"
  }
}
